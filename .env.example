# ============================================================================
# Alle-AI Verify (Celo) — Environment Configuration Template
# Copy to .env (which is gitignored). NEVER commit real private keys or API keys.
# ============================================================================

# 1. Celo RPC Endpoints
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_MAINNET_RPC_URL=https://forno.celo.org

# 2. Dedicated Project Wallets (Generated locally via `npm run wallet:generate`)
# NEVER print, log, or commit private keys.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# 3. Deployed Contract Addresses (Populated after deployment)
SEPOLIA_VERIFICATION_REGISTRY=
MAINNET_VERIFICATION_REGISTRY=

# 4. Agent Identity IDs (Populated after registration)
SEPOLIA_ERC8004_AGENT_ID=
MAINNET_ERC8004_AGENT_ID=
SEPOLIA_SELF_AGENT_ID=
MAINNET_SELF_AGENT_ID=

# 5. Explorer Verification API Key (Optional for Celoscan / Sourcify / Blockscout)
CELOSCAN_API_KEY=

# 6. Alle-AI Multi-Model API Configuration
ALLE_AI_API_BASE_URL=https://api.alle-ai.com/api/v1
ALLE_AI_API_KEY=
ALLE_AI_DEFAULT_MODELS=claude-sonnet-4-5,gpt-5-1,gemini-2-5-pro

# 7. Service Configuration
PORT=3001
ACTIVE_NETWORK=sepolia
